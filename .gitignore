.orchestrator/
# License key material (#124) — private keys must never be committed. `gen`
# also refuses to write into a git tree; this is belt-and-suspenders.
*.pem
SoundBuddy-keys/

# Playwright MCP snapshot cache
.playwright-mcp/

# Local wrangler state (KV simulation, build cache)
worker/.wrangler/
site/.wrangler/

# Unscrubbed console captures (#893). Raw .scn dumps off the M32R carry
# identifying material; only the scrubbed capture committed under
# packages/console/src is allowed in this public repo, and git history is
# permanent. Name any local raw capture `*.local.scn`.
*.local.scn

# Software factory runtime state is local to each machine (queue, logs, events,
# cost ledger, plans, port leases). The constitution is the deliberate exception:
# factory 2.0 resolves the consumer repo's own .factory/constitution.md as its
# authoritative standards instance, so it belongs in version control.
.factory/*
!.factory/constitution.md
