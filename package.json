{
  "name": "sound-buddy",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @sound-buddy/shared -w @sound-buddy/license-policy -w @sound-buddy/scene-inspector -w @sound-buddy/audio-engine -w @sound-buddy/console -w @sound-buddy/cli",
    "lint": "npm run lint --workspaces --if-present && npm run lint --prefix app && eslint . --max-warnings 0",
    "test": "npm run coverage",
    "coverage": "npm run coverage:deps && vitest run --coverage",
    "coverage:deps": "node scripts/coverage-deps.mjs",
    "dev": "npm run dev -w @sound-buddy/cli",
    "smoke:release": "node scripts/release-smoke.mjs",
    "factory:merge-aisle": "node scripts/factory/run-merge-aisle.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
