{
  "name": "sound-buddy-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated Cloudflare Worker for Sound Buddy Stripe / licensing endpoints",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test",
    "test:e2e:sandbox": "node --env-file=../.env.local scripts/e2e-sandbox.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "miniflare": "5.20260828.0-alpha",
    "typescript": "^5.6.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@sound-buddy/license-policy": "file:../packages/license-policy",
    "stripe": "^23.2.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd@1.20260811.1": true
  }
}
